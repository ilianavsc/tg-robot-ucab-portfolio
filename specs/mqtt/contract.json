{
  "version": "2.0.0",
  "schema_version": "2.0.0",
  "nombre": "Contrato MQTT Robot UCAB (HIL + Simuladores + Capa 3 Operacional)",
  "estado": "canonico",
  "prefijo": "ucab-tg-sf/robot",
  "brokers": [
    {
      "nombre": "HiveMQ",
      "host": "broker.hivemq.com",
      "puertoTcp": 1883,
      "puertoWss": 8884,
      "urlWss": "wss://broker.hivemq.com:8884/mqtt"
    },
    {
      "nombre": "EMQX",
      "host": "broker.emqx.io",
      "puertoTcp": 1883,
      "puertoWss": 8084,
      "urlWss": "wss://broker.emqx.io:8084/mqtt"
    },
    {
      "nombre": "Mosquitto",
      "host": "test.mosquitto.org",
      "puertoTcp": 1883,
      "puertoWss": 8081,
      "urlWss": "wss://test.mosquitto.org:8081/mqtt"
    }
  ],
  "topicos": {
    "estado": {
      "ruta": "ucab-tg-sf/robot/estado",
      "qos": 0,
      "retained": false,
      "direccion": "robot->app"
    },
    "ultrasonido": {
      "ruta": "ucab-tg-sf/robot/ultrasonido",
      "qos": 0,
      "retained": false,
      "direccion": "robot->app"
    },
    "ordenes": {
      "ruta": "ucab-tg-sf/robot/ordenes",
      "qos": 1,
      "retained": false,
      "direccion": "app->robot"
    },
    "ack": {
      "ruta": "ucab-tg-sf/robot/ordenes/ack",
      "qos": 1,
      "retained": false,
      "direccion": "robot->app"
    },
    "alertas": {
      "ruta": "ucab-tg-sf/robot/alertas",
      "qos": 2,
      "retained": false,
      "direccion": "robot->app"
    },
    "conexion": {
      "ruta": "ucab-tg-sf/robot/conexion",
      "qos": 1,
      "retained": true,
      "direccion": "robot->app",
      "lwt": "desconectado",
      "enLinea": "en linea"
    },
    "rutas_estado": {
      "ruta": "ucab-tg-sf/robot/rutas/estado",
      "qos": 1,
      "retained": true,
      "direccion": "robot->app",
      "nota": "Estado vigente al reconectar"
    },
    "rutas_escaneo": {
      "ruta": "ucab-tg-sf/robot/rutas/escaneo",
      "qos": 1,
      "retained": false,
      "direccion": "app->robot",
      "nota": "Comandos y eventos de escaneo"
    },
    "rutas_reposicionamiento": {
      "ruta": "ucab-tg-sf/robot/rutas/reposicionamiento",
      "qos": 1,
      "retained": false,
      "direccion": "app->robot",
      "nota": "Confirmación manual obligatoria en ESPERA_REPOSICION"
    },
    "pedidos_solicitud": {
      "ruta": "ucab-tg-sf/robot/pedidos/solicitud",
      "qos": 1,
      "retained": false,
      "direccion": "app->robot",
      "nota": "Solicitud de pedido sobre ruta con parada configurada"
    },
    "pedidos_estado": {
      "ruta": "ucab-tg-sf/robot/pedidos/estado",
      "qos": 1,
      "retained": true,
      "direccion": "robot->app",
      "nota": "Estado vigente de pedido al reconectar"
    },
    "pedidos_cancelacion": {
      "ruta": "ucab-tg-sf/robot/pedidos/cancelacion",
      "qos": 1,
      "retained": false,
      "direccion": "app->robot",
      "nota": "Cancelación segura preservando la ruta aprendida"
    },
    "sensores_inercial": {
      "ruta": "ucab-tg-sf/robot/sensores/inercial",
      "qos": 0,
      "retained": false,
      "direccion": "robot->app",
      "nota": "Telemetría continua MPU-6050"
    }
  },
  "comandosValidos": [
    "adelante",
    "atras",
    "izquierda",
    "derecha",
    "frenar",
    "auto"
  ],
  "tiempos": {
    "ackTimeoutMs": 5000,
    "manualFailSafeMs": 5000,
    "telemetriaIntervaloMs": 1500,
    "keepAliveS": 15
  },
  "trazabilidad": {
    "camposObligatorios": [
      "message_id",
      "request_id",
      "sequence",
      "timestamp",
      "schema_version"
    ],
    "deduplicacion": "message_id + sequence monotónica por emisor; request_id correlaciona el ciclo de vida de cada pedido."
  },
  "capa3Operacional": {
    "fuenteDeVerdad": "prototipos/P05-gemelo-digital/capa3_operacional.js",
    "estadosRuta": [
      "SIN_RUTA",
      "ESCANEO_IDA",
      "ESPERA_REPOSICION",
      "ESCANEO_RETORNO",
      "OPERACION_BUCLE",
      "REESCANEO_PARADA",
      "OPERACION_CON_PARADA",
      "PAUSA_OBSTACULO",
      "ERROR_SEGURIDAD",
      "RECUPERACION_MANUAL"
    ],
    "estadosPedido": [
      "SIN_PEDIDO",
      "SOLICITADO",
      "EN_TRANSITO",
      "CANCELACION_SEGURA",
      "ENTREGADO"
    ],
    "alertasMpu6050": [
      "impacto",
      "inclinacion",
      "atascamiento"
    ],
    "invariantesSeguridad": {
      "movimientoBloqueadoEnEstados": [
        "ESPERA_REPOSICION",
        "ERROR_SEGURIDAD",
        "RECUPERACION_MANUAL"
      ],
      "descripcion": "Las órdenes de movimiento (adelante, atras, izquierda, derecha, auto) son rechazadas cuando estado_ruta pertenece a ESPERA_REPOSICION, ERROR_SEGURIDAD o RECUPERACION_MANUAL."
    }
  },
  "payloads": {
    "estado": {
      "fisicoHIL": [
        "n",
        "estado",
        "bateria",
        "bateria_v",
        "ordenes",
        "linea_mm",
        "v_izq",
        "v_der",
        "parada",
        "t"
      ],
      "exclusivosSimuladorP04": [
        "progreso_m",
        "largo_m",
        "sensores"
      ]
    },
    "ultrasonido": {
      "fisicoHIL": [
        "frente_cm",
        "atras_cm",
        "frente_ok",
        "atras_ok",
        "t"
      ]
    },
    "orden": {
      "campos": ["id", "cmd"]
    },
    "ack": {
      "campos": ["id", "recibidas", "t"]
    },
    "rutas_estado": {
      "campos": [
        "tipo_ruta",
        "estado_ruta",
        "parada_configurada",
        "usos_completados",
        "movimiento_bloqueado",
        "timestamp",
        "schema_version"
      ],
      "enums": {
        "tipo_ruta": ["cerrada", "lineal"],
        "estado_ruta": [
          "SIN_RUTA",
          "ESCANEO_IDA",
          "ESPERA_REPOSICION",
          "ESCANEO_RETORNO",
          "OPERACION_BUCLE",
          "REESCANEO_PARADA",
          "OPERACION_CON_PARADA",
          "PAUSA_OBSTACULO",
          "ERROR_SEGURIDAD",
          "RECUPERACION_MANUAL"
        ]
      }
    },
    "rutas_escaneo": {
      "campos": [
        "accion",
        "fase",
        "escala_reloj",
        "progreso_m",
        "t_sim_s",
        "t_restante_s",
        "message_id",
        "sequence",
        "timestamp",
        "schema_version"
      ],
      "enums": {
        "accion": ["iniciar", "pausar", "reanudar", "finalizar"],
        "fase": ["ida", "retorno", "bucle"],
        "escala_reloj": [1, 2, 4]
      }
    },
    "rutas_reposicionamiento": {
      "campos": [
        "confirmado",
        "origen",
        "message_id",
        "sequence",
        "timestamp",
        "schema_version"
      ],
      "enums": {
        "origen": ["manual_usuario"]
      }
    },
    "pedidos_solicitud": {
      "campos": [
        "request_id",
        "parada_id",
        "con_carga",
        "message_id",
        "sequence",
        "timestamp",
        "schema_version"
      ]
    },
    "pedidos_estado": {
      "campos": [
        "request_id",
        "estado_pedido",
        "ruta_preservada",
        "timestamp",
        "schema_version"
      ],
      "enums": {
        "estado_pedido": [
          "SIN_PEDIDO",
          "SOLICITADO",
          "EN_TRANSITO",
          "CANCELACION_SEGURA",
          "ENTREGADO"
        ]
      }
    },
    "pedidos_cancelacion": {
      "campos": [
        "request_id",
        "motivo",
        "modo",
        "message_id",
        "sequence",
        "timestamp",
        "schema_version"
      ],
      "enums": {
        "modo": ["CANCELACION_SEGURA"]
      }
    },
    "sensores_inercial": {
      "campos": [
        "pitch",
        "roll",
        "acel_g",
        "alerta",
        "timestamp",
        "schema_version"
      ],
      "alertaValores": [null, "impacto", "inclinacion", "atascamiento"]
    }
  }
}
