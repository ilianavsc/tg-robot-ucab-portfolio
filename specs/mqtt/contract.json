{
  "version": "2.0.0",
  "schema_version": "2.0.0",
  "nombre": "Contrato MQTT Robot UCAB (HIL + Simuladores + Capa 3 Operacional)",
  "estado": "canonico",
  "prefijo": "ucab-tg-sf/robot",
  "brokers": [
    {
      "nombre": "HiveMQ",
      "host": "broker.hivemq.com",
      "puertoTcp": 1883,
      "puertoWss": 8884,
      "urlWss": "wss://broker.hivemq.com:8884/mqtt"
    },
    {
      "nombre": "EMQX",
      "host": "broker.emqx.io",
      "puertoTcp": 1883,
      "puertoWss": 8084,
      "urlWss": "wss://broker.emqx.io:8084/mqtt"
    },
    {
      "nombre": "Mosquitto",
      "host": "test.mosquitto.org",
      "puertoTcp": 1883,
      "puertoWss": 8081,
      "urlWss": "wss://test.mosquitto.org:8081/mqtt"
    }
  ],
  "topicos": {
    "estado": {
      "ruta": "ucab-tg-sf/robot/estado",
      "qos": 0,
      "retained": false,
      "direccion": "robot->app"
    },
    "ultrasonido": {
      "ruta": "ucab-tg-sf/robot/ultrasonido",
      "qos": 0,
      "retained": false,
      "direccion": "robot->app"
    },
    "ordenes": {
      "ruta": "ucab-tg-sf/robot/ordenes",
      "qos": 1,
      "retained": false,
      "direccion": "app->robot"
    },
    "ack": {
      "ruta": "ucab-tg-sf/robot/ordenes/ack",
      "qos": 1,
      "retained": false,
      "direccion": "robot->app"
    },
    "alertas": {
      "ruta": "ucab-tg-sf/robot/alertas",
      "qos": 2,
      "retained": false,
      "direccion": "robot->app"
    },
    "conexion": {
      "ruta": "ucab-tg-sf/robot/conexion",
      "qos": 1,
      "retained": true,
      "direccion": "robot->app",
      "lwt": "desconectado",
      "enLinea": "en linea"
    },
    "rutas_estado": {
      "ruta": "ucab-tg-sf/robot/rutas/estado",
      "qos": 1,
      "retained": true,
      "direccion": "robot->app"
    },
    "rutas_escaneo": {
      "ruta": "ucab-tg-sf/robot/rutas/escaneo",
      "qos": 1,
      "retained": false,
      "direccion": "app->robot"
    },
    "rutas_reposicionamiento": {
      "ruta": "ucab-tg-sf/robot/rutas/reposicionamiento",
      "qos": 1,
      "retained": false,
      "direccion": "app->robot"
    },
    "pedidos_solicitud": {
      "ruta": "ucab-tg-sf/robot/pedidos/solicitud",
      "qos": 1,
      "retained": false,
      "direccion": "app->robot"
    },
    "pedidos_estado": {
      "ruta": "ucab-tg-sf/robot/pedidos/estado",
      "qos": 1,
      "retained": true,
      "direccion": "robot->app"
    },
    "pedidos_cancelacion": {
      "ruta": "ucab-tg-sf/robot/pedidos/cancelacion",
      "qos": 1,
      "retained": false,
      "direccion": "app->robot"
    },
    "sensores_inercial": {
      "ruta": "ucab-tg-sf/robot/sensores/inercial",
      "qos": 0,
      "retained": false,
      "direccion": "robot->app"
    }
  },
  "comandosValidos": [
    "adelante",
    "atras",
    "izquierda",
    "derecha",
    "frenar",
    "auto"
  ],
  "tiempos": {
    "ackTimeoutMs": 5000,
    "manualFailSafeMs": 5000,
    "telemetriaIntervaloMs": 1500,
    "keepAliveS": 15
  },
  "capa3Operacional": {
    "fuenteDeVerdad": "prototipos/P05-gemelo-digital/capa3_operacional.js",
    "estadosRuta": [
      "SIN_RUTA",
      "ESCANEO_IDA",
      "ESPERA_REPOSICION",
      "ESCANEO_RETORNO",
      "OPERACION_BUCLE",
      "REESCANEO_PARADA",
      "OPERACION_CON_PARADA",
      "PAUSA_OBSTACULO",
      "ERROR_SEGURIDAD",
      "RECUPERACION_MANUAL"
    ],
    "estadosPedido": [
      "SIN_PEDIDO",
      "SOLICITADO",
      "EN_TRANSITO",
      "CANCELACION_SEGURA",
      "ENTREGADO"
    ],
    "alertasMpu6050": [
      "impacto",
      "inclinacion",
      "atascamiento"
    ],
    "invariantesSeguridad": {
      "movimientoBloqueadoEnEstados": [
        "ESPERA_REPOSICION",
        "ERROR_SEGURIDAD",
        "RECUPERACION_MANUAL"
      ],
      "descripcion": "Las órdenes de movimiento (adelante, atras, izquierda, derecha, auto) son rechazadas cuando estado_ruta pertenece a ESPERA_REPOSICION, ERROR_SEGURIDAD o RECUPERACION_MANUAL."
    }
  },
  "payloads": {
    "estado": {
      "fisicoHIL": [
        "n",
        "estado",
        "bateria",
        "bateria_v",
        "ordenes",
        "linea_mm",
        "v_izq",
        "v_der",
        "parada",
        "t"
      ],
      "exclusivosSimuladorP04": [
        "progreso_m",
        "largo_m",
        "sensores"
      ]
    },
    "ultrasonido": {
      "fisicoHIL": [
        "frente_cm",
        "atras_cm",
        "frente_ok",
        "atras_ok",
        "t"
      ]
    },
    "orden": {
      "campos": ["id", "cmd"]
    },
    "ack": {
      "campos": ["id", "recibidas", "t"]
    },
    "rutas_estado": {
      "campos": [
        "tipo_ruta",
        "estado_ruta",
        "parada_configurada",
        "parada_nombre",
        "usos_completados",
        "progreso_pasada_m",
        "largo_m",
        "t"
      ]
    },
    "rutas_escaneo": {
      "campos": ["accion", "tipo_ruta", "parada_nombre"]
    },
    "rutas_reposicionamiento": {
      "campos": ["confirmado", "operador", "t"]
    },
    "pedidos_solicitud": {
      "campos": ["id", "componente", "destino", "t"]
    },
    "pedidos_estado": {
      "campos": ["id", "estado_pedido", "ruta_conservada", "t"]
    },
    "pedidos_cancelacion": {
      "campos": ["id", "motivo", "conservar_ruta", "t"]
    },
    "sensores_inercial": {
      "campos": ["pitch", "roll", "acel_g", "alerta", "t"],
      "alertaValores": [null, "impacto", "inclinacion", "atascamiento"]
    }
  }
}
